# ══════════════════════════════════════════════════════════════
# Automated Agentic AI Web Agency — Environment Configuration
# ══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values

# ── Agency Branding (Whitelabel) ──────────────────────────────
AGENCY_NAME="Web Agency"              # Your agency's display name
AGENCY_CALLER_NAME="Alex"             # AI caller persona name for phone calls
AGENCY_OWNER_NAME="The Owner"         # Owner/CEO name shown in messages
AGENCY_EMAIL=""                        # Primary contact email (e.g. hello@yourdomain.com)
AGENCY_PHONE=""                        # Agency phone number (for CTA defaults)
AGENCY_SLUG="web-agency"              # URL-safe agency identifier

# ── Pricing (Whitelabel) ────────────────────────────────────
PRICE_SETUP="35"                      # One-time website setup fee (£)
PRICE_MONTHLY="5"                     # Monthly hosting + changes fee (£)
PRICE_DOMAIN="25"                     # Domain registration + email setup fee (£)
DEFAULT_TLD=".co.uk"                  # Default domain TLD for suggestions

# ── Testing / Demo ──────────────────────────────────────────
DEMO_PHONE=""                         # (Optional) Override: route ALL outbound calls to this number
MOCK_SCOUT="false"                    # Set to "true" to scout from packages/api/src/data/mock-places.json instead of Google Places

# Dashboard Branding (Vite — prefix with VITE_)
VITE_AGENCY_NAME="Web Agency"
VITE_AGENCY_OWNER_NAME="The Owner"
VITE_AGENCY_EMAIL=""
VITE_AGENCY_DOMAIN=""                  # Your agency's domain (e.g. youragency.com)

# ── Supabase ──────────────────────────────────────────────────
SUPABASE_URL=""                        # Your Supabase project URL
SUPABASE_SERVICE_KEY=""                # Service role key (NOT anon key)

# ── Vercel ────────────────────────────────────────────────────
VERCEL_TOKEN=""                        # Vercel API token for deployments
VERCEL_TEAM_ID=""                      # (Optional) Vercel team/org ID

# ── Bland.ai (Phone Calls) ───────────────────────────────────
BLAND_AI_API_KEY=""                    # Bland.ai API key for outbound calls

# ── Stripe (Payments) ────────────────────────────────────────
STRIPE_SECRET_KEY=""                   # Stripe secret key
STRIPE_PRICE_SETUP=""                  # Price ID for website setup fee
STRIPE_PRICE_DOMAIN=""                 # Price ID for domain registration
STRIPE_WEBHOOK_SECRET=""               # Webhook signing secret (for /closing/stripe/webhook)
STRIPE_SUCCESS_URL=""                  # URL after successful payment
STRIPE_CANCEL_URL=""                   # URL if payment cancelled

# ── Telegram (Admin Notifications + HITL) ───────────────────
TELEGRAM_BOT_TOKEN=""                  # Bot token from @BotFather
TELEGRAM_ADMIN_CHAT_ID=""             # Your Telegram chat ID for admin notifications

# ── Email (Resend) ────────────────────────────────────────────
RESEND_API_KEY=""                      # Resend API key
OUTREACH_FROM_NAME=""                  # Sender display name
OUTREACH_FROM_EMAIL=""                 # Verified sender email

# ── Twilio (Client SMS/WhatsApp) ─────────────────────────────
TWILIO_ACCOUNT_SID=""                  # Twilio account SID
TWILIO_AUTH_TOKEN=""                   # Twilio auth token
TWILIO_SMS_FROM=""                     # Twilio SMS sender number (e.g. +44...)
TWILIO_WHATSAPP_FROM=""                # Twilio WhatsApp number (tries WhatsApp first, falls back to SMS)

# ── Google Places API ────────────────────────────────────────
GOOGLE_PLACES_API_KEY=""               # Google Places API key for lead discovery

# ── OpenAI (Hero Image Generation) ───────────────────────────
OPENAI_API_KEY=""                      # OpenAI API key — leave blank to skip hero images (sites keep a CSS gradient hero)
OPENAI_IMAGE_MODEL="gpt-image-2.5-flare"  # gpt-image-2.5-flare (fast) | gpt-image-2.5-sunburst (detail) | gpt-image-1-mini (cheap)
OPENAI_IMAGE_QUALITY="medium"          # low | medium | high | xhigh | max — roughly $0.01 to $0.20 per image
OPENAI_IMAGE_SIZE="1536x1024"          # Landscape hero; any WIDTHxHEIGHT in multiples of 16 up to 3:1
HERO_IMAGES="true"                     # Set "false" to disable hero images even when OPENAI_API_KEY is set

# ── Business Verification (Verifier agent) ───────────────────
COMPANIES_HOUSE_API_KEY=""             # (Optional) Companies House API key — https://developer.company-information.service.gov.uk
VIABILITY_THRESHOLD="40"              # Minimum viability score (0-100) for a lead to pass verification

# ── Calendly ─────────────────────────────────────────────────
CALENDLY_LINK=""                       # Your Calendly booking link

# ── Queue behaviour ──────────────────────────────────────────
QUEUE_STALE_MINUTES="30"              # Queue items stuck in "processing" longer than this are marked failed (retry from dashboard)
AUTO_FETCH_MAX_INFLIGHT="10"          # Auto-fetch stops scouting new leads while this many items are pending/processing

# ── Server ───────────────────────────────────────────────────
PORT=3001                              # API server port
API_URL="http://localhost:3001"        # Public API URL (for tracking pixels etc.)
